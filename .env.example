# Copia este archivo como .env (cp .env.example .env) y llénalo. El .env nunca se sube.
# Dirección de tu API: la de tu fila en la hoja Equipos
API_URL=https://www.datos.gov.co/resource/xxxx-xxxx.json
# Filtro opcional: campo=valor; varios se unen con &
API_FILTRO=
# Opcional: token de datos.gov.co si la API limita tus solicitudes
SOCRATA_APP_TOKEN=
